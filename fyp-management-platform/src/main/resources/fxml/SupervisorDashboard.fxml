<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fyp.controller.SupervisorDashboardController"
            styleClass="root-pane" prefWidth="1200" prefHeight="750">
    <top>
        <!-- Issue 14 fix: spacing="12" -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="FYP Nexus" styleClass="top-bar-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" styleClass="top-bar-user"/>
            <Button fx:id="notifBtn" styleClass="notif-btn" onAction="#openNotifications" id="supNotifBtn">
                <graphic><StackPane><Label text="🔔" style="-fx-font-size:18;"/><Label fx:id="notifBadge" styleClass="notif-badge" text="0"/></StackPane></graphic>
            </Button>
            <Button text="Logout" styleClass="btn-outline-small" onAction="#handleLogout" id="supLogoutBtn"/>
        </HBox>
    </top>
    <left>
        <!-- Issue 13 fix: fx:id on every sidebar button -->
        <VBox styleClass="sidebar" spacing="4" prefWidth="210">
            <Label text="SUPERVISOR MENU" styleClass="sidebar-section-label"/>
            <Button fx:id="supNavDash"      text="🏠  Dashboard"        styleClass="sidebar-btn sidebar-btn-active" onAction="#showDashboard"   id="supNavDash"/>
            <Button fx:id="supNavProposals" text="📋  Pending Proposals" styleClass="sidebar-btn" onAction="#showProposals"   id="supNavProposals"/>
            <Button fx:id="supNavProjects"  text="📁  My Projects"       styleClass="sidebar-btn" onAction="#showProjects"    id="supNavProjects"/>
            <Button fx:id="supNavMilestones" text="🎯  Milestones"       styleClass="sidebar-btn" onAction="#showMilestones"  id="supNavMilestones"/>
            <!-- Issue 7 fix: Feedback now uses 📝 instead of 💬 -->
            <Button fx:id="supNavFeedback"  text="📝  Feedback"          styleClass="sidebar-btn" onAction="#showFeedback"    id="supNavFeedback"/>
            <Button fx:id="supNavMeetings"  text="📅  Meetings"          styleClass="sidebar-btn" onAction="#showMeetings"    id="supNavMeetings"/>
            <Button fx:id="supNavDiscussion" text="💬  Discussion"        styleClass="sidebar-btn" onAction="#showDiscussion"  id="supNavDiscussion"/>
            <Button fx:id="supNavGrading"   text="🏆  Grading"           styleClass="sidebar-btn" onAction="#showGrading"     id="supNavGrading"/>
            <Button fx:id="supNavProfile"   text="👤  Profile"           styleClass="sidebar-btn" onAction="#showProfile"     id="supNavProfile"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
            <StackPane fx:id="contentPane" styleClass="content-pane">
                <VBox fx:id="dashboardContent" spacing="24" styleClass="dashboard-content">
                    <Label fx:id="welcomeLabel" text="Supervisor Dashboard" styleClass="page-title"/>
                    <!-- Issue 8 fix: stat card color variants -->
                    <HBox spacing="16">
                        <VBox styleClass="stat-card stat-card-orange" HBox.hgrow="ALWAYS"><Label text="Pending Reviews" styleClass="stat-label"/><Label fx:id="pendingLabel" text="0" styleClass="stat-value"/></VBox>
                        <VBox styleClass="stat-card stat-card-blue"   HBox.hgrow="ALWAYS"><Label text="Active Projects"  styleClass="stat-label"/><Label fx:id="projectsLabel" text="0" styleClass="stat-value"/></VBox>
                        <VBox styleClass="stat-card stat-card-teal"   HBox.hgrow="ALWAYS"><Label text="Slots Available"  styleClass="stat-label"/><Label fx:id="slotsLabel"    text="0" styleClass="stat-value"/></VBox>
                        <VBox styleClass="stat-card stat-card-purple" HBox.hgrow="ALWAYS"><Label text="Upcoming Meetings" styleClass="stat-label"/><Label fx:id="meetLabel"    text="0" styleClass="stat-value"/></VBox>
                    </HBox>
                    <VBox styleClass="content-card" spacing="12">
                        <Label text="Pending Proposals" styleClass="card-title"/>
                        <TableView fx:id="proposalsTable" prefHeight="250" styleClass="dark-table">
                            <columns>
                                <TableColumn fx:id="propTitleCol"   text="Title"    prefWidth="280"/>
                                <TableColumn fx:id="propStudentCol" text="Student"  prefWidth="160"/>
                                <TableColumn fx:id="propDateCol"    text="Submitted" prefWidth="120"/>
                                <TableColumn fx:id="propActionCol"  text="Action"   prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
