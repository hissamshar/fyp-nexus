<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fyp.controller.IndustryPartnerDashboardController"
            styleClass="root-pane" prefWidth="1200" prefHeight="750">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="FYP Platform - Industry Partner" styleClass="top-bar-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" styleClass="top-bar-user"/>
            <Button text="Logout" styleClass="btn-outline-small" onAction="#handleLogout" id="indLogoutBtn"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="210">
            <Label text="INDUSTRY MENU" styleClass="sidebar-section-label"/>
            <Button text="🏠  Dashboard" styleClass="sidebar-btn sidebar-btn-active" onAction="#showDashboard"/>
            <Button text="➕  Post Problem" styleClass="sidebar-btn" onAction="#showPostProblem"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
            <StackPane fx:id="contentPane" styleClass="content-pane">
                <VBox fx:id="dashboardContent" spacing="24" styleClass="dashboard-content">
                    <Label text="My Industry Problems" styleClass="page-title"/>
                    <Label text="Industry interaction module coming soon." styleClass="login-subtitle"/>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
