<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fyp.controller.DeliverableUploadController"
      styleClass="dashboard-content" spacing="20" style="-fx-background-color:#F5F5F7;">

    <Label text="Deliverables" styleClass="page-title"/>

    <VBox styleClass="content-card" spacing="16">
        <Label text="Upload New Deliverable" styleClass="card-title"/>

        <HBox spacing="12">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Milestone" styleClass="field-label"/>
                <ComboBox fx:id="milestoneCombo" promptText="Select milestone" styleClass="combo-dark"
                          maxWidth="Infinity" id="deliverableMilestone"/>
            </VBox>
        </HBox>

        <Label text="Title" styleClass="field-label"/>
        <TextField fx:id="dTitleField" promptText="Deliverable title" styleClass="text-field-dark" id="deliverableTitle"/>

        <Label text="Description" styleClass="field-label"/>
        <TextArea fx:id="dDescField" promptText="Brief description..." styleClass="text-field-dark"
                  prefHeight="80" wrapText="true" id="deliverableDesc"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="selectedFileLabel" text="No file selected"
                   style="-fx-text-fill:#86868B; -fx-font-size:13;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📁  Choose File" styleClass="btn-outline-small" onAction="#handleChooseFile" id="chooseFileBtn"/>
        </HBox>

        <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>
        <Button text="Upload Deliverable" styleClass="btn-primary" onAction="#handleUpload" id="uploadBtn"/>
    </VBox>

    <VBox styleClass="content-card" spacing="12">
        <Label text="Uploaded Deliverables" styleClass="card-title"/>
        <TableView fx:id="deliverablesTable" prefHeight="220" styleClass="dark-table" id="deliverablesTable">
            <columns>
                <TableColumn fx:id="dTitleCol"     text="Title"       prefWidth="200"/>
                <TableColumn fx:id="dMilestoneCol" text="Milestone"   prefWidth="160"/>
                <TableColumn fx:id="dStatusCol"    text="Status"      prefWidth="100"/>
                <TableColumn fx:id="dDateCol"      text="Uploaded"    prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
